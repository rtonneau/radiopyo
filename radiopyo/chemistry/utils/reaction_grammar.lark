// Main node definition
start: kreaction | ereaction

// Main rules for reactions
ereaction: reactants "--"~1 enzyme ">>"~1 products
kreaction: reactants "->"~1 products

reactants: species_list
products: species_list

// Generic species list in a reaction
species_list: species ("+"~1 species)*

// Species definitions
species: multiple? (atom | molecule | radical | ion) | element
enzyme: multiple? (atom | molecule) | element
element: WORD // Some species like 'catalase' doesn't have a formula

//Charged species
ion: cation | anion
cation: (atom | molecule | radical) PLUS+
anion: ELECTRON | ((atom | molecule | radical) MINUS+)

//Radical species
radical: (atom|molecule) RADICAL?

//Molecular species 
molecule: atom atom+
atom: CAPITAL_LETTER LOWER_LETTER? stoi?

multiple: DIGIT+
stoi: DIGIT+

ELECTRON: "e_aq"
CHARGE: (PLUS | MINUS)

CAPITAL_LETTER: /[A-Z]/
LOWER_LETTER: /[a-z]/
PLUS: "+" | "_plus"
MINUS: "-" | "_minus"
RADICAL: "_r"
DIGIT: /[0-9]/

%import common.WORD -> WORD
%import common.WS -> WS
%ignore WS